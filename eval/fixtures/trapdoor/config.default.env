# TRAP E1 — a CHECKED-IN, NON-SECRET defaults file.
#
# It is committed on purpose: these are the shipped defaults every environment starts from, and
# nothing here is a credential. A live build refused to read it because the filename matched a
# "secret file" pattern, and the whole Config & environments table came back thin as a result.
# The correct behaviour is to read it and record the keys; the secret VALUES live in the
# deployment platform, and the two placeholders below say so in the file itself.

TRAPDOOR_ROLE=api
HTTP_PORT=8080
LOG_LEVEL=info
REQUEST_TIMEOUT_SECONDS=30

# Datastore — host/port only. Credentials are injected by the platform, never stored here.
PRIMARY_URI=mongodb://primary:27017/trapdoor
PRIMARY_POOL_SIZE=16

# Broker
BROKER_URL=redis://broker:6379/0
BROKER_CONSUMER_GROUP=trapdoor-workers

# Search index (the OpenSearch dep that shares a name with a compose service — trap D5)
SEARCH_URL=http://search:9200
SEARCH_INDEX=tickets

# Hosted services. Tokens are NOT here.
ANALYTICS_URL=https://analytics.invalid
ANALYTICS_TOKEN=__injected_at_deploy__
ERRORS_URL=https://errors.invalid
ERRORS_TOKEN=__injected_at_deploy__

# Escalation tuning
ESCALATION_GRACE_SECONDS=900
ESCALATION_RETRY_BUDGET=3
